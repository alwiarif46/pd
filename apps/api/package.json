    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "stripe": "22.6.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "embedded-postgres": "16.14.0-beta.17",
