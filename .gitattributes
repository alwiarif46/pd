# Everything under infra/ and ops/ runs on Linux: keep LF in the repo AND in the working tree.
# Scope is deliberately narrow (no global "* text=auto"): only files that are executed or parsed on a server.
*.sh text eol=lf
*.py text eol=lf
*.nft text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.template text eol=lf
*.conf text eol=lf
.githooks/* text eol=lf
*/tests/fakes/* text eol=lf
infra/server/cloudflare-ips.txt text eol=lf
