# Database
DATABASE_URL=postgresql://pd_app:password@localhost:5432/pd
# Password of the owner role pd_owner (migrations, backups).
POSTGRES_PASSWORD=change_this_in_production
# Password of the runtime role pd_app (api, worker). Different from the owner password.
# The migration creates pd_app without a password; set it out of band, see
# docs/plans/01-infrastructure.md section 6.
PD_APP_PASSWORD=change_this_too

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Proxies whose X-Forwarded-For the API believes, so the per-IP send caps see the client's
# address: a comma-separated list of IPs or CIDR ranges (or loopback, linklocal, uniquelocal).
# Unset: trust no proxy. Never `true` or `*`; the API refuses them.
# PD_TRUST_PROXY=127.0.0.1
# Local development only: print email links and SMS codes to stdout while no email or SMS
# delivery is configured. Takes effect only together with NODE_ENV=development; never set
# either in production.
# NODE_ENV=development
# PD_DEV_PRINT_SECRETS=1

# AI Providers
DEEPINFRA_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (06 s5). Billing is available (Checkout, Portal) only when the secret key, both price
# ids, and APP_URL are set; the webhook (POST /api/billing/webhook) also needs the webhook
# signing secret. Prices live only in Stripe: these are the Price ids (price_...), not amounts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# The web app's public origin, for the Checkout and Portal return links. No trailing path.
APP_URL=http://localhost:3000

# Email and SMS delivery (sign-up links, phone codes, reset links, invites). Each channel is on
# when its settings are set, and off when none are. Half a channel, or an invalid value, stops the
# api in any environment. With NODE_ENV=production (the Docker image default) the api refuses to
# start unless both channels are on. Leave both off locally to use PD_DEV_PRINT_SECRETS above.
# On the server these live in /opt/pd/.env (security/secrets-inventory.md). Never commit a key.
#
# Email, sent with Resend (https://api.resend.com). The key needs sending access only.
RESEND_API_KEY=
# The From header: "Name <address>" or a bare address, on a domain verified in Resend.
# PD_EMAIL_FROM="Shaavir PD <no-reply@notify.shaavir.com>"   (quoted: the value has spaces)
PD_EMAIL_FROM=
# Email links open APP_URL (set under Stripe above): #/verify, #/reset and #/invite.
# It must be https with NODE_ENV=production, e.g. https://pd.shaavir.com.
#
# SMS, sent with Telnyx (https://api.telnyx.com/v2/messages).
TELNYX_API_KEY=
# Set TELNYX_FROM (an E.164 number on the account, e.g. +15551234567), TELNYX_MESSAGING_PROFILE_ID,
# or both. The profile id is sent whenever it is set; with only the profile, the profile must have
# a number pool so Telnyx can choose the sending number.
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=

# Testers only: a comma-separated list of exact email addresses whose phone verification is
# skipped (no SMS is sent at sign-up; email verification is still required). Case-insensitive.
# No wildcards or domains: any entry that is not one exact address stops the api. Unset or empty
# is off. The api logs one warning with the count at startup and a line (user id only) each
# time the skip is used. Remove it when testing ends.
# PD_SKIP_PHONE_VERIFY_EMAILS=pat@example.com,sam@example.com
PD_SKIP_PHONE_VERIFY_EMAILS=

# Archive Storage
ARCHIVE_PROVIDER=
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
ARCHIVE_BUCKET=
ARCHIVE_REGION=

# Off-site Backup
BACKUP_TARGET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_BUCKET=
BACKUP_REGION=

# Error Tracking
ERROR_TRACKING_DSN=
