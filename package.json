{
  "name": "pd",
  "version": "0.1.0",
  "private": true,
  "description": "Proposal Development Tool for government contractors",
  "workspaces": [
    "services/*",
    "services/gateway/web",
    "services/ingest/sandbox",
    "packages/*",
    "evals"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:db": "tsx services/gateway/scripts/dev-db.ts",
    "dev:api": "tsx services/gateway/scripts/dev-api.ts",
    "dev:stack": "bash infra/local/native-stack.sh",
    "seed": "tsx packages/testing/scripts/seed.ts",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:infra": "bash infra/tests/run-tests.sh && bash ops/tests/run-tests.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "migrate": "tsx packages/service-kit/scripts/migrate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "contracts:check": "pnpm --filter @pd/contracts check",
    "contracts:check:bump": "pnpm --filter @pd/contracts check:bump"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
