{
  "name": "pd",
  "version": "0.1.0",
  "private": true,
  "description": "Proposal Development Tool for government contractors",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
