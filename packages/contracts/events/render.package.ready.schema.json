{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.e2e.local/events/render.package.ready",
  "title": "render.package.ready",
  "x-owner": "render",
  "x-stream": "e2e.render.package.ready",
  "x-schema-version": "1.1",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://contracts.e2e.local/events/_envelope"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "const": "render.package.ready"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "payload": {
      "type": "object",
      "description": "Payload of render.package.ready: a package is built and downloadable.",
      "additionalProperties": false,
      "required": [
        "package_id",
        "run_id",
        "file_count"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "word_only_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
