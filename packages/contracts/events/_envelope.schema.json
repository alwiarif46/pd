{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.e2e.local/events/_envelope",
  "title": "Event envelope",
  "description": "Fields every event carries (09 s2). Per-event schemas extend this with allOf.",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "schema_version",
    "occurred_at",
    "type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
