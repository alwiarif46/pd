{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.e2e.local/events/render.issue.found",
  "title": "render.issue.found",
  "x-owner": "render",
  "x-stream": "e2e.render.issue.found",
  "x-schema-version": "1.1",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://contracts.e2e.local/events/_envelope"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "const": "render.issue.found"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "payload": {
      "type": "object",
      "description": "Payload of render.issue.found: one layout issue on one page.",
      "additionalProperties": false,
      "required": [
        "render_id",
        "run_id",
        "volume_id",
        "page",
        "kind",
        "severity",
        "detail",
        "source"
      ],
      "properties": {
        "render_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "volume_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "overflow",
            "broken_table",
            "cut_graphic",
            "orphan_heading",
            "margin",
            "other"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "warning"
          ]
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "geometry",
            "vision"
          ]
        },
        "block_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
