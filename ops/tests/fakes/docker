#!/usr/bin/env bash
# fake docker for the ops tests: logs argv to $FAKE_CALLS (and the stdin size of exec/run), answers the few
# queries the scripts make from FAKE_* env. The real Docker is never reached.
printf 'docker %s\n' "$*" >>"${FAKE_CALLS:-/dev/null}"
args=" $* "
case "$1" in
  compose)
    case "$args" in
      *" exec "*)
        case "$args" in
          *" pg_dump "*) printf 'FAKE-PGDUMP\n' ;;
          *" pg_restore "*) bytes="$(wc -c)"; printf 'docker-stdin-bytes %s\n' "$bytes" >>"${FAKE_CALLS:-/dev/null}" ;;
          *" pg_isready "*) : ;;
          *) : ;;
        esac ;;
    esac
    exit "${FAKE_COMPOSE_EXIT:-0}" ;;
  volume)
    # docker volume inspect infra_postgres_data
    [[ "$2" == inspect && "$3" == infra_postgres_data && "${FAKE_OLD_VOLUME:-0}" == 1 ]] && exit 0
    [[ "$2" == inspect ]] && exit 1
    exit 0 ;;
  run) echo "fakecontainerid0123456789"; exit "${FAKE_DOCKER_RUN_EXIT:-0}" ;;
  exec)
    case "$args" in
      *" pg_isready "*) exit 0 ;;
      *" psql "*)
        case "$args" in
          *"__drizzle_migrations"*) echo "${FAKE_MIGRATIONS:-3}" ;;
          *"organizations"*) echo "${FAKE_ORGS:-2}" ;;
          *) : ;;
        esac
        cat >/dev/null 2>&1 || true ;;
      *" pg_restore "*) cat >/dev/null ;;
    esac
    exit 0 ;;
  rm | stop | start | pull | build | ps | logs | image) exit 0 ;;
esac
exit 0
