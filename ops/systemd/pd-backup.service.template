# /etc/systemd/system/pd-backup.service - rendered by ops/install.sh. Hourly encrypted database backup.
[Unit]
Description=PD database backup (pg_dump -> Borg on /mnt/pdbackup -> B2)
Requires=docker.service
After=docker.service mnt-pdbackup.mount
RequiresMountsFor=/mnt/pddata /mnt/pdbackup
# A failed run is recorded and logged at priority err (ops/backup/alert.sh; notifier hook: HUMAN-TODO H-11).
OnFailure=pd-alert@%n.service

[Service]
Type=oneshot
ExecStart={{PROJECT_DIR}}/infra/scripts/backup.sh
Nice=10
TimeoutStartSec=3h
