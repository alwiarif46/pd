# Laptop secrets file for the infra scripts. Copy to the path named by [tenant] secrets_file in
# config/tenant.toml (C:/projects/secrets/pd.env) or point PD_SECRETS / --secrets at it.
# KEY=VALUE lines, parsed and never sourced. NEVER commit the filled-in copy.
#
# This is the LAPTOP file. It is separate from the server's /opt/pd/.env (app settings, written by hand on
# the server) and from /etc/pd/rclone.env (backup keys, written by ops/backup/rclone-setup.sh).
#
# Only the keys of the chosen [infra] provider are needed:
#   provider "ovh-us"   OS_APPLICATION_CREDENTIAL_ID + OS_APPLICATION_CREDENTIAL_SECRET
#                       (or OS_USERNAME + OS_PASSWORD + OS_PROJECT_ID)
#   provider "hetzner"  HCLOUD_TOKEN
#   provider "ssh"      nothing (SSH_PUBKEY_PATH and ADMIN_IP only)

# --- provider "ovh-us" (OpenStack) ---
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_ID=

# --- provider "hetzner" ---
HCLOUD_TOKEN=

# --- every provider ---
# Cloudflare API token limited to Zone:DNS:Edit on [tenant] dns_zone (infra/dns/cloudflare-dns.py).
CLOUDFLARE_DNS_TOKEN=
# Backblaze B2 keys used by the laptop-side checks only (the server's keys live in /etc/pd/rclone.env).
B2_KEY_ID=
B2_APP_KEY=
# Public key put on the new server for pdadmin.
SSH_PUBKEY_PATH=
# Your current public IPv4/IPv6 address: the first-boot SSH rule is limited to it.
ADMIN_IP=
