# Variables of 09 s9.2 for the local stack, grouped by service. Names only matter: each service reads its own folder's .env.
# Copy the lines a service needs into services/<id>/.env (never committed). Values are dev defaults for the local stack;
# provider keys and Stripe keys stay empty and come from your own session or shell, never from a file in git.
# For the native stack (no Docker): eval "$(infra/local/native-stack.sh env)" prints the matching exports.
# The Compose stack's own settings are in infra/compose/local.env.example.

# Which local stack the tests expect: compose (infra/compose/local.yml) or native (infra/local/native-stack.sh).
E2E_STACK=compose

# ---- Every service
# <SERVICE>_DATABASE_URL below: the service's own role. `pnpm migrate` gives the role a password only when
# <SERVICE>_DB_PASSWORD is set while it runs; use the same value here. 'password' is a placeholder.
REDIS_URL=redis://127.0.0.1:6379
GATEWAY_JWKS_URL=http://127.0.0.1:8080/oauth/v2/keys
APP_SETTINGS_SCHEMA=app

# ---- Migrations (pnpm migrate)
# Compose Postgres: the superuser of infra/compose/local.env, database E2E_DB_NAME. Native stack: port 54329, trust login.
PD_ADMIN_DATABASE_URL=postgres://postgres@127.0.0.1:5432/e2e

# ---- Per-service database URLs (search_path is the service's schema)
IDENTITY_DATABASE_URL=postgres://identity_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Didentity
BILLING_DATABASE_URL=postgres://billing_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dbilling
INGEST_DATABASE_URL=postgres://ingest_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dingest
INTEL_DATABASE_URL=postgres://intel_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dintel
ORCHESTRATOR_DATABASE_URL=postgres://orchestrator_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dorchestrator
MODELGW_DATABASE_URL=postgres://modelgw_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dmodelgw
DRAFTING_DATABASE_URL=postgres://drafting_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Ddrafting
REVIEW_DATABASE_URL=postgres://review_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dreview
RENDER_DATABASE_URL=postgres://render_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Drender
EVIDENCE_DATABASE_URL=postgres://evidence_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Devidence
COMMS_DATABASE_URL=postgres://comms_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dcomms
PORTAL_DATABASE_URL=postgres://portal_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dportal
DRIVE_DATABASE_URL=postgres://drive_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Ddrive
NOTIFY_DATABASE_URL=postgres://notify_svc:password@127.0.0.1:5432/e2e?options=-csearch_path%3Dnotify

# ---- Ingest, render, evidence, drafting: object storage (SeaweedFS in Compose, in-memory double in native)
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=pd-local
S3_ACCESS_KEY=dev-only-s3-access
S3_SECRET_KEY=dev-only-s3-secret-key

# ---- Identity: Zitadel
IDENTITY_ZITADEL_URL=http://localhost:8080
IDENTITY_ZITADEL_CLIENT_ID=
# Compose writes the machine key to the volume pd-local_zitadel_bootstrap (/zitadel-bootstrap/identity-sa.json).
IDENTITY_ZITADEL_SERVICE_KEY=

# ---- Ingest: virus scan (not in 09 s9.2; host and port of clamd)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---- Model gateway only: provider keys. Empty here; set them in the shell for a session, never in git.
MODELGW_ANTHROPIC_API_KEY=
MODELGW_REVIEWER_API_KEY=
MODELGW_IMAGE_API_KEY=

# ---- Billing: Stripe test keys
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# ---- Comms
COMMS_INBOUND_WEBHOOK_SECRET=

# ---- Drafting, review, render scripts
RENDER_TOOLRUNNER_URL=http://127.0.0.1:4109
BID_LEDGER_URL=
