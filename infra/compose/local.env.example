# Dev-only values for infra/compose/local.yml. Copy to infra/compose/local.env (not in git) and change them.
# Every value below is a placeholder for a throwaway local stack. None is a real secret.
# The secret scan allows this file by name; lines carry the marker so a copy pasted elsewhere is still allowed.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres-pw  # secret-scan: allow
E2E_DB_NAME=e2e
ZITADEL_DB_USER=zitadel
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_PASSWORD=dev-only-zitadel-db-pw  # secret-scan: allow

# Zitadel. The master key must be exactly 32 characters.
ZITADEL_MASTERKEY=dev-only-masterkey-0123456789abc  # secret-scan: allow
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Dev-Only-Admin-Pw-1!  # secret-scan: allow
ZITADEL_ORG_NAME=PD Local

# S3 (SeaweedFS)
S3_ACCESS_KEY=dev-only-s3-access  # secret-scan: allow
S3_SECRET_KEY=dev-only-s3-secret-key  # secret-scan: allow
S3_BUCKET=pd-local

# Host ports (all bound to 127.0.0.1)
POSTGRES_PORT=5432
REDIS_PORT=6379
ZITADEL_PORT=8080
S3_PORT=8333
CLAMAV_PORT=3310
