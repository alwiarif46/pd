# infra/server/pd-host-firewall.service -> /etc/systemd/system/ (cloud-init, host-firewall.sh)
# Loads the PD host firewall (one nftables table) before the network comes up. Not Ubuntu's
# nftables.service: that one runs `flush ruleset` on stop, which would also wipe Docker's rules.
[Unit]
Description=PD host firewall (nftables table inet pd_fw)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/pd/host-firewall.nft
ExecReload=/usr/sbin/nft -f /etc/pd/host-firewall.nft

[Install]
WantedBy=sysinit.target
